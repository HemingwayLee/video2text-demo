# Copy to .env and fill in ONE of these. Docker Compose reads .env automatically.

# Claude Pro/Max subscription: run `claude setup-token` in your terminal and paste the token.
CLAUDE_CODE_OAUTH_TOKEN=

# Or pay-as-you-go API billing with a key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Folder with downloaded reels, mounted into the backend at /reels (default: ~/Downloads/reels).
# REELS_HOST_DIR=
# Whisper model for STT: tiny | base | small | medium (default) | large-v3
# WHISPER_MODEL=
